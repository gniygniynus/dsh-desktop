{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面版：内嵌 harness，带删除会话 / 对话撤回 / 粘贴加供应商",
  "private": true,
  "type": "module",
  "main": "electron/entry.js",
  "scripts": {
    "start": "electron .",
    "test:boot": "node scripts/test-boot.mjs",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.6"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "dsh-desktop",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "patches/**",
      "plugins/**",
      "scripts/**",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
